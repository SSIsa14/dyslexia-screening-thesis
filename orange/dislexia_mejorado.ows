		<properties node_id="57" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\xdf\x00\x00\x03/\x00\x00\x00\x01\x00\x00\x00\x1e\x00\x00\x03\xde\x00\x00\x03.\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x01\x00\x00\x00\x1e\x00\x00\x03\xde\x00\x00\x03.', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import pandas as pd\nimport numpy as np\nfrom sklearn.metrics import confusion_matrix as sklearn_cm\n\n# 1. Preparar los datos\n# \'in_data.Y\' tiene la columna real de Dyslexia\n# \'in_data.metas\' tiene las probabilidades y las nuevas predicciones\ny_true = in_data.Y.flatten() \n\n# Buscamos la probabilidad de Logistic Regression para recrear el 0.5 de Orange\nprob_idx = [i for i, m in enumerate(in_data.domain.metas) if "Logistic Regression (Yes)" in m.name][0]\nprobs = in_data.metas[:, prob_idx]\n\n# Creamos las predicciones manuales para que coincidan con los umbrales\npreds_05 = (probs &gt;= 0.5).astype(int) # Esto debería darte los números de la foto\npreds_02 = (probs &gt;= 0.2).astype(int) # Esto es tu ajuste\n\n# 2. Etiquetas (1 es Yes, 0 es No)\nlabels = [1, 0] \n\ndef print_cm(cm, title):\n    print(f"\\n--- MATRIZ: {title} ---")\n    print("                PREDICHO")\n    print("               YES(1)   NO(0)")\n    print(f"ACTUAL YES(1) |  {cm[0][0]:&lt;5} |  {cm[0][1]:&lt;5} |")\n    print(f"       NO (0) |  {cm[1][0]:&lt;5} |  {cm[1][1]:&lt;5} |")\n    print("-" * 40)\n\n# 3. Calcular Matrices\ncm_05 = sklearn_cm(y_true, preds_05, labels=labels)\ncm_02 = sklearn_cm(y_true, preds_02, labels=labels)\n\n# 4. Resultados finales\nprint("="*45)\nprint("🎯 COMPARATIVA FINAL: RECREANDO ORANGE")\nprint("="*45)\n\nprint_cm(cm_05, "MODELO ORIGINAL (Umbral 0.5)")\nprint_cm(cm_02, "MODELO AJUSTADO (Umbral 0.2)")\n\n# El gran final\nrescatados = cm_02[0][0] - cm_05[0][0]\nprint(f"\\n🚀 ¡IMPACTO DEMOSTRADO!")\nprint(f"Al mover el umbral a 0.2, el modelo detectó a {rescatados}")\nprint(f"niños con dislexia que el modelo de Orange (0.5) ignoraba.")\nprint("="*45)', 'filename': None}], 'scriptText': 'import pandas as pd\nimport numpy as np\nfrom sklearn.metrics import confusion_matrix as sklearn_cm\n\n# 1. Preparar los datos\n# \'in_data.Y\' tiene la columna real de Dyslexia\n# \'in_data.metas\' tiene las probabilidades y las nuevas predicciones\ny_true = in_data.Y.flatten() \n\n# Buscamos la probabilidad de Logistic Regression para recrear el 0.5 de Orange\nprob_idx = [i for i, m in enumerate(in_data.domain.metas) if "Logistic Regression (Yes)" in m.name][0]\nprobs = in_data.metas[:, prob_idx]\n\n# Creamos las predicciones manuales para que coincidan con los umbrales\npreds_05 = (probs &gt;= 0.5).astype(int) # Esto debería darte los números de la foto\npreds_02 = (probs &gt;= 0.2).astype(int) # Esto es tu ajuste\n\n# 2. Etiquetas (1 es Yes, 0 es No)\nlabels = [1, 0] \n\ndef print_cm(cm, title):\n    print(f"\\n--- MATRIZ: {title} ---")\n    print("                PREDICHO")\n    print("               YES(1)   NO(0)")\n    print(f"ACTUAL YES(1) |  {cm[0][0]:&lt;5} |  {cm[0][1]:&lt;5} |")\n    print(f"       NO (0) |  {cm[1][0]:&lt;5} |  {cm[1][1]:&lt;5} |")\n    print("-" * 40)\n\n# 3. Calcular Matrices\ncm_05 = sklearn_cm(y_true, preds_05, labels=labels)\ncm_02 = sklearn_cm(y_true, preds_02, labels=labels)\n\n# 4. Resultados finales\nprint("="*45)\nprint("🎯 COMPARATIVA FINAL: RECREANDO ORANGE")\nprint("="*45)\n\nprint_cm(cm_05, "MODELO ORIGINAL (Umbral 0.5)")\nprint_cm(cm_02, "MODELO AJUSTADO (Umbral 0.2)")\n\n# El gran final\nrescatados = cm_02[0][0] - cm_05[0][0]\nprint(f"\\n🚀 ¡IMPACTO DEMOSTRADO!")\nprint(f"Al mover el umbral a 0.2, el modelo detectó a {rescatados}")\nprint(f"niños con dislexia que el modelo de Orange (0.5) ignoraba.")\nprint("="*45)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="58" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\xdf\x00\x00\x03/\x00\x00\x00\x01\x00\x00\x00\x1e\x00\x00\x03\xde\x00\x00\x03.\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x01\x00\x00\x00\x1e\x00\x00\x03\xde\x00\x00\x03.', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import pandas as pd\nimport numpy as np\nfrom sklearn.metrics import confusion_matrix as sklearn_cm\n\n# 1. Convertimos a Pandas\ndf = pd.DataFrame(in_data)\n\n# 2. Extraemos por posición (Dyslexia, Original, Ajustado)\n# Convertimos todo a string y limpiamos espacios\ny_true = df.iloc[:, 0].astype(str).str.strip()\ny_orig = df.iloc[:, 1].astype(str).str.strip()\ny_adj  = df.iloc[:, 2].astype(str).str.strip()\n\n# 3. AUTO-DETECCIÓN DE ETIQUETAS\n# Esto evita el error: busca lo que sea que haya en los datos\nlabels_detectados = sorted(y_true.unique(), reverse=True) \n# Generalmente el primero será "Yes" o "1.0" (lo positivo)\n\ndef print_cm(cm, title, labs):\n    print(f"\\n--- MATRIZ: {title} ---")\n    print("                PREDICHO")\n    print(f"               {labs[0]:&lt;8} {labs[1]:&lt;8}")\n    print(f"ACTUAL {labs[0]:&lt;5} |  {cm[0][0]:&lt;8} |  {cm[0][1]:&lt;8} |")\n    print(f"       {labs[1]:&lt;5} |  {cm[1][0]:&lt;8} |  {cm[1][1]:&lt;8} |")\n    print("-" * 50)\n\n# 4. Calcular Matrices con las etiquetas reales que encontró el script\ncm_orig = sklearn_cm(y_true, y_orig, labels=labels_detectados)\ncm_adj = sklearn_cm(y_true, y_adj, labels=labels_detectados)\n\n# 5. Resultados finales\nprint("="*55)\nprint("🎯 COMPARATIVA FINAL: MODELO RANDOM FOREST")\nprint(f"Etiquetas encontradas en tus datos: {labels_detectados}")\nprint("="*55)\n\nprint_cm(cm_orig, "RF ORIGINAL (0.5)", labels_detectados)\nprint_cm(cm_adj, "RF AJUSTADO (0.2)", labels_detectados)\n\n# Cálculo de impacto\nrescatados = int(cm_adj[0][0]) - int(cm_orig[0][0])\nprint(f"\\n🚀 ¡IMPACTO DEMOSTRADO!")\nprint(f"Al mover el umbral, detectamos a {rescatados} niños más")\nprint(f"con dislexia que el modelo original ignoraba.")\nprint("="*55)', 'filename': None}], 'scriptText': 'import pandas as pd\nimport numpy as np\nfrom sklearn.metrics import confusion_matrix as sklearn_cm\n\n# 1. Convertimos a Pandas\ndf = pd.DataFrame(in_data)\n\n# 2. Extraemos por posición (Dyslexia, Original, Ajustado)\n# Convertimos todo a string y limpiamos espacios\ny_true = df.iloc[:, 0].astype(str).str.strip()\ny_orig = df.iloc[:, 1].astype(str).str.strip()\ny_adj  = df.iloc[:, 2].astype(str).str.strip()\n\n# 3. AUTO-DETECCIÓN DE ETIQUETAS\n# Esto evita el error: busca lo que sea que haya en los datos\nlabels_detectados = sorted(y_true.unique(), reverse=True) \n# Generalmente el primero será "Yes" o "1.0" (lo positivo)\n\ndef print_cm(cm, title, labs):\n    print(f"\\n--- MATRIZ: {title} ---")\n    print("                PREDICHO")\n    print(f"               {labs[0]:&lt;8} {labs[1]:&lt;8}")\n    print(f"ACTUAL {labs[0]:&lt;5} |  {cm[0][0]:&lt;8} |  {cm[0][1]:&lt;8} |")\n    print(f"       {labs[1]:&lt;5} |  {cm[1][0]:&lt;8} |  {cm[1][1]:&lt;8} |")\n    print("-" * 50)\n\n# 4. Calcular Matrices con las etiquetas reales que encontró el script\ncm_orig = sklearn_cm(y_true, y_orig, labels=labels_detectados)\ncm_adj = sklearn_cm(y_true, y_adj, labels=labels_detectados)\n\n# 5. Resultados finales\nprint("="*55)\nprint("🎯 COMPARATIVA FINAL: MODELO RANDOM FOREST")\nprint(f"Etiquetas encontradas en tus datos: {labels_detectados}")\nprint("="*55)\n\nprint_cm(cm_orig, "RF ORIGINAL (0.5)", labels_detectados)\nprint_cm(cm_adj, "RF AJUSTADO (0.2)", labels_detectados)\n\n# Cálculo de impacto\nrescatados = int(cm_adj[0][0]) - int(cm_orig[0][0])\nprint(f"\\n🚀 ¡IMPACTO DEMOSTRADO!")\nprint(f"Al mover el umbral, detectamos a {rescatados} niños más")\nprint(f"con dislexia que el modelo original ignoraba.")\nprint("="*55)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
