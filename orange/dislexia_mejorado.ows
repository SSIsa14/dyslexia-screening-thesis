		<properties node_id="19" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x01\x00\x00\x00\x1e\x00\x00\x03\x07\x00\x00\x03.\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'from Orange.data import Table, Domain, DiscreteVariable\nimport numpy as np\n\nthreshold = 0.2\n\nif in_data is not None:\n    actual = in_data.Y.flatten() \n    class_values = in_data.domain.class_var.values\n    yes_idx = list(class_values).index("Yes")\n    no_idx = list(class_values).index("No")\n    \n    # Contamos cuántos hay de cada uno para el promedio ponderado\n    n_yes = np.sum(actual == yes_idx)\n    n_no = np.sum(actual == no_idx)\n    total = len(actual)\n\n    prob_indices = [i for i, m in enumerate(in_data.domain.metas) if "(Yes)" in m.name]\n    new_metas = list(in_data.domain.metas)\n    for idx in prob_indices:\n        model_name = in_data.domain.metas[idx].name.replace("(Yes)", "Adj 0.2")\n        new_metas.append(DiscreteVariable(model_name, values=("No", "Yes")))\n    \n    new_domain = Domain(in_data.domain.attributes, in_data.domain.class_var, metas=new_metas)\n    new_table = Table.from_table(new_domain, in_data)\n    \n    print("="*75)\n    print(f"{\'MODELO\':&lt;18} | {\'TARGET\':&lt;7} | {\'CA\':&lt;6} | {\'F1\':&lt;6} | {\'PREC\':&lt;6} | {\'RECALL\':&lt;6}")\n    print("-" * 75)\n    \n    offset = len(in_data.domain.metas)\n    for i, prob_idx in enumerate(prob_indices):\n        m_name = in_data.domain.metas[prob_idx].name.replace("(Yes)", "").strip()[:18]\n        probs = in_data.metas[:, prob_idx]\n        preds = (probs &gt;= threshold).astype(int)\n        \n        # Matriz de Confusión básica\n        tp = np.sum((preds == yes_idx) &amp; (actual == yes_idx))\n        fp = np.sum((preds == yes_idx) &amp; (actual == no_idx))\n        fn = np.sum((preds == no_idx) &amp; (actual == yes_idx))\n        tn = np.sum((preds == no_idx) &amp; (actual == no_idx))\n        \n        # MÉTRICAS CLASE YES\n        rec_y = tp / (tp + fn) if (tp + fn) &gt; 0 else 0\n        pre_y = tp / (tp + fp) if (tp + fp) &gt; 0 else 0\n        f1_y = 2 * (pre_y * rec_y) / (pre_y + rec_y) if (pre_y + rec_y) &gt; 0 else 0\n        \n        # MÉTRICAS CLASE NO\n        rec_n = tn / (tn + fp) if (tn + fp) &gt; 0 else 0\n        pre_n = tn / (tn + fn) if (tn + fn) &gt; 0 else 0\n        f1_n = 2 * (pre_n * rec_n) / (pre_n + rec_n) if (pre_n + rec_n) &gt; 0 else 0\n        \n        # PROMEDIO PONDERADO (Estilo Orange Test and Score)\n        ca = (tp + tn) / total\n        f1_avg = (f1_y * n_yes + f1_n * n_no) / total\n        pre_avg = (pre_y * n_yes + pre_n * n_no) / total\n        rec_avg = (rec_y * n_yes + rec_n * n_no) / total\n        \n        # Imprimimos las 3 filas por modelo\n        print(f"{m_name:&lt;18} | {\'Yes\':&lt;7} | {ca:.3f} | {f1_y:.3f} | {pre_y:.3f} | {rec_y:.3f}")\n        print(f"{\'\':&lt;18} | {\'No\':&lt;7} | {ca:.3f} | {f1_n:.3f} | {pre_n:.3f} | {rec_n:.3f}")\n        print(f"{\'\':&lt;18} | {\'Average\':&lt;7} | {ca:.3f} | {f1_avg:.3f} | {pre_avg:.3f} | {rec_avg:.3f}")\n        print("-" * 75)\n\n        # Llenamos la tabla de salida\n        for row_idx in range(len(new_table)):\n            new_table.metas[row_idx, offset + i] = preds[row_idx]\n            \n    out_data = new_table', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xbb\x00\x00\x02 \x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
